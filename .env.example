# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# RESEND_API_KEY: Server-side Resend API key used to send 2FA and order emails.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxx"

# ORDER_EMAIL_FROM: Verified sender/domain in Resend (must be verified in Resend before production sending).
ORDER_EMAIL_FROM="YourPets <orders@your-verified-domain.com>"

# ORDER_NOTIFICATION_EMAIL: Store owner email receiving order notifications.
ORDER_NOTIFICATION_EMAIL="craftking990@gmail.com"

# VITE_ADMIN_EMAIL: Frontend admin email allowed to access the admin order view.
VITE_ADMIN_EMAIL="craftking990@gmail.com"

# --- EmailJS (order notifications) -------------------------------------------
# These three are EmailJS's PUBLIC browser identifiers. They are visible in the
# built site by design and are not secrets. The EmailJS *Private Key* is the
# secret one and must never be added here or anywhere in this project.
# Restrict the public key to your own domains in the EmailJS dashboard under
# Account -> Security -> Allowed origins.
VITE_EMAILJS_SERVICE_ID="service_4y3191s"
VITE_EMAILJS_TEMPLATE_ID="template_0jzhrf9"
VITE_EMAILJS_PUBLIC_KEY="B-IQlCgvLUYHOuh6n"

# --- Firebase (accounts & sign-in) -------------------------------------------
# Optional. Leave unset to use the project bundled in
# firebase-applet-config.json. Set all three to point the site at your OWN
# Firebase project instead — values from the Firebase console under
# Project settings -> General -> Your apps -> SDK setup and configuration.
# Email/Password must be enabled there: Authentication -> Sign-in method.
# See docs/firebase-setup.md.
# VITE_FIREBASE_API_KEY=""
# VITE_FIREBASE_PROJECT_ID=""
# VITE_FIREBASE_APP_ID=""
# VITE_FIREBASE_AUTH_DOMAIN=""
# VITE_FIREBASE_STORAGE_BUCKET=""
# VITE_FIREBASE_MESSAGING_SENDER_ID=""
# VITE_FIREBASE_FIRESTORE_DATABASE_ID=""
