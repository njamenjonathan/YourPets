# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# RESEND_API_KEY: Server-side Resend API key used to send 2FA and order emails.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxx"

# ORDER_EMAIL_FROM: Verified sender/domain in Resend (must be verified in Resend before production sending).
ORDER_EMAIL_FROM="YourPets <orders@your-verified-domain.com>"

# ORDER_NOTIFICATION_EMAIL: Store owner email receiving order notifications.
ORDER_NOTIFICATION_EMAIL="craftking990@gmail.com"

# VITE_ADMIN_EMAIL: Frontend admin email allowed to access the admin order view.
VITE_ADMIN_EMAIL="craftking990@gmail.com"
