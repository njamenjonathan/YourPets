+const toUserAccount = (fbUser: { uid: string; email: string | null; displayName: string | null }): UserAccount => {
+  const email = (fbUser.email || '').toLowerCase();
+  return {
+    uid: fbUser.uid,
+    name: fbUser.displayName || email.split('@')[0] || 'Member',
+    email,
